worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    access_log off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    map $http_upgrade $connection_upgrade { default upgrade; '' ''; }
    server {
        listen LAN_LISTEN_IP:443 ssl;
        listen [TAILNET_LISTEN_IPV6]:443 ssl;
        server_name PRIVATE_HOSTNAME;
        ssl_certificate /certs/live/CERTIFICATE_NAME/fullchain.pem;
        ssl_certificate_key /certs/live/CERTIFICATE_NAME/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:private_tv:2m;
        allow 192.168.3.0/24;
        allow 192.168.40.0/24;
        allow 100.64.0.0/10;
        allow fd7a:115c:a1e0::/48;
        deny all;
        # No Cloudflare HTTP Tunnel route is created for this service.
        if ($http_cf_ray != '') { return 403; }
        if ($host != PRIVATE_HOSTNAME) { return 444; }
        client_max_body_size 40m;
        location / {
            proxy_pass https://WINDOWS_BACKEND_IP:7443;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/nginx/windows-ca.crt;
            proxy_ssl_name localhost;
            proxy_ssl_server_name on;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
